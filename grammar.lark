
 // Punto de inicio del lenguaje
start: statement*

// Declaraciones e instrucciones
?statement: var_decl
          | print_stmt
          | if_stmt

// Declaracion de variables
var_decl: "varutepsa" NAME "=" expr ";"

// Impresion de resultados
print_stmt: "printbecas" "(" expr ")" ";"

// Condicionales
if_stmt: "ifapruebemeinge" "(" comparison ")" block ["elsenomerepruebe" block]

// Bloques de instrucciones
block: "{" statement* "}"

// Comparaciones
comparison: expr COMP_OP expr

// Operaciones aritmeticas
?expr: expr "+" term   -> add
     | expr "-" term   -> sub
     | term

?term: term "*" factor -> mul
     | term "/" factor -> div
     | factor

?factor: NUMBER        -> number
       | STRING        -> string
       | NAME          -> variable
       | "(" expr ")"
       | "-" factor    -> neg

// Elementos lexicos
COMP_OP: "==" | "!=" | "<=" | ">=" | "<" | ">"

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
NUMBER: /[0-9]+(\.[0-9]+)?/
STRING: ESCAPED_STRING

%import common.WS
%import common.ESCAPED_STRING
%ignore WS
%ignore /\/\/[^\n]*/
